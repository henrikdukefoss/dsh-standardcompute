{
  "name": "dsh-standardcompute",
  "version": "0.1.0",
  "description": "Standard Compute provider for DeepSeek Harness: one OpenAI-compatible route with a cost router and direct model pins.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/index.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check:models": "node scripts/check-models.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm test"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "standardcompute",
    "llm-provider",
    "openai-compatible"
  ],
  "author": "Standard Compute <contact@standardcompute.com>",
  "license": "MIT",
  "homepage": "https://github.com/henrikdukefoss/dsh-standardcompute#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/henrikdukefoss/dsh-standardcompute.git"
  },
  "bugs": {
    "url": "https://github.com/henrikdukefoss/dsh-standardcompute/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "yaml": "^2.9.1"
  }
}
